# Global Configuration
NODE_ENV=development

# Backend Configuration
PORT=5000
DATABASE_URL="file:./dev.db"
# For PostgreSQL (Production):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fincoach?schema=public"

JWT_SECRET="fintech-ai-coach-super-secure-jwt-secret-key-upay-2026"
JWT_REFRESH_SECRET="fintech-ai-coach-super-secure-refresh-secret-upay-2026"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Client CORS
CLIENT_URL="http://localhost:5173"

# AI Provider Configuration
# Optional: Provide Gemini API Key, otherwise deterministic fallback coach is automatically active!
GEMINI_API_KEY=""
AI_PROVIDER="fallback" # "gemini" or "fallback"

# Demo & Currency
DEFAULT_CURRENCY="BDT"
DEFAULT_LOCALE="en-BD"
